# Corner — canonical environment inventory.
#
# This root file is the COMPLETE inventory. Every process.env key read anywhere
# in the codebase must appear here with a placeholder and a one-line comment.
# Backend loaders call dotenv.config() for the CWD first, then backfill from
# this repo-root .env (CONVENTIONS.md "Environment files").
#
# Keys are added in the phase that first reads them. Phase 2 has landed the
# data models only, so the AI-provider and storage keys below are declared but
# not yet read by any code — they are listed now so the inventory never lags
# behind the design.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development                    # development | production | test
PORT=8080                               # HTTP port for the API web service

# ---- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/corner   # Mongo connection string. Atlas in prod (vector search requires Atlas).
                                              # MUST include the /corner database path. A URI with no path
                                              # silently connects to `test`; boot refuses if it does.
MONGODB_DB_NAME=corner                        # Database Corner asserts it is connected to at boot.
MONGODB_MAX_POOL_SIZE=10                      # Sockets per process. Low on purpose while sharing a cluster.

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=replace-me-with-64-chars-minimum-see-conventions-md-auth-section
JWT_EXPIRES_IN=30d                      # Token lifetime. Pepta convention; 64-char secret minimum is enforced.

# ---- Object storage (Phase 2 services; Cloudflare R2 is the cheap default) ---
STORAGE_ENDPOINT=                       # S3-compatible endpoint. R2: https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto                     # R2 uses "auto"; real S3 uses a region name.
STORAGE_BUCKET=                         # Bucket holding source blobs, audio, thumbnails.
STORAGE_ACCESS_KEY_ID=                  # Server-only. Never EXPO_PUBLIC_.
STORAGE_SECRET_ACCESS_KEY=              # Server-only.

# ---- AI providers (behind swappable interfaces; see CONVENTIONS.md) ----------
LLM_API_KEY=                            # Script generation, action-item extraction, summaries, chat.
EMBEDDINGS_API_KEY=                     # Chunk vectorization. May equal LLM_API_KEY depending on vendor.
TTS_API_KEY=                            # Cloud voice synthesis for narration.

# ---- RevenueCat -------------------------------------------------------------
REVENUECAT_WEBHOOK_SECRET=              # Shared secret, timing-safe compared. Fail-closed if unset in production.
REVENUECAT_SECRET_API_KEY=              # Server key for evidence-gated subscriber reads.

# ---- Frontend (Expo public keys — Phase 3, prefixed EXPO_PUBLIC_) ------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080  # Backend origin the app talks to.
EXPO_PUBLIC_POSTHOG_API_KEY=            # PostHog project key (second analytics destination).
EXPO_PUBLIC_POSTHOG_HOST=               # PostHog ingestion host.
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY=false # Replay opt-in. MUST stay unset/false by default; see CONVENTIONS.md.
